<!-- ================================================================
     PROCESS ANOMALY DETECTION - EID 1
     Uses if_group>sysmon_event1 + providerName field check.
     if_group references the runtime group tag assigned by rule 61603
     above during event processing. No load-order dependency.
     Logic: suspicious image fires at level 12, legitimate parent
     image silences the alert at level 0 (override pattern).
================================================================ -->
<group name="windows,sysmon,sysmon_process-anomalies,">

  <!-- T1055 - svchost.exe -->
  <rule id="61618" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\svchost\.exe$</field>
    <description>Sysmon Native [T1055]: Suspicious process - svchost.exe with non-standard parent image</description>
    <options>no_full_log</options>
    <mitre><id>T1055</id></mitre>
    <group>pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SI.4,tsc_CC7.2,tsc_CC7.3,tsc_CC6.1,tsc_CC6.8,</group>
  </rule>

  <rule id="61619" level="0">
    <if_sid>61618</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\\\services\.exe$</field>
