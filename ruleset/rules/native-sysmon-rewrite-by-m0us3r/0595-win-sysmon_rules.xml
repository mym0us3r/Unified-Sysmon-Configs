    <group>pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SI.4,tsc_CC7.2,tsc_CC7.3,tsc_CC6.1,tsc_CC6.8,</group>
  </rule>

  <rule id="61641" level="0">
    <if_sid>61640</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\\\userinit\.exe$</field>
    <description>Sysmon Native: Legitimate parent image - explorer.exe spawned by userinit.exe</description>
    <options>no_full_log</options>
  </rule>

</group>

