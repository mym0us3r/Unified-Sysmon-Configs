  Rewrite by m0us3r - https://github.com/mym0us3r/Unified-Sysmon-Configs
  Date: 03/27/2026 Friday :)

  Sysmon Event ID 10 rules: 92899 - 92950
  Rewritten for Sysmon Native (Windows 11 24H2+)
  Provider: Microsoft-Windows-Sysmon
  EID 10: Process Access
  MITRE ATT&CK v15 aligned

  ESCAPING REFERENCE (critical):
    Wazuh decoder doubles backslashes in Windows paths.
    Stored internally: C:\\Windows\\System32\\cmd.exe (double backslash)
    PCRE2 to match \\: use \\\\
    Rule: path separators -> \\\\ | regex meta (\s \d \b \.) -> \\

  MIGRATION NOTES:
    Legacy anchor if_group>sysmon_event_10 replaced by:
      if_sid>92899 (Native EID 10 anchor, this file)
    ANCHOR FIX: if_sid>60000 replaced by if_group>sysmon_event_10
    Base anchor was: if_sid>60000 + providerName + eventID ^10$ (rule 92899)
    All child rules chain from if_sid>92899 or their logical parent.
    Full parity with Wazuh 4.14.4 server ruleset + complete MITRE coverage.
-->
<group name="sysmon,sysmon_eid10_detections,windows,">

  <!-- ================================================================
       BASE ANCHOR - EID 10 (Process Access)
  ================================================================ -->
  <rule id="92899" level="0">
    <if_group>sysmon_event_10</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <description>Sysmon Native [EID 10]: Process $(win.eventdata.targetImage) accessed by $(win.eventdata.sourceImage)</description>
    <options>no_full_log</options>
  </rule>

  <!-- T1003.001 - lsass.exe accessed with read permissions (credential dump) -->
  <rule id="92900" level="12">
    <if_sid>92899</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\\\lsass\.exe</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)(0x1010|0x40)</field>
    <field name="win.eventdata.sourceImage" type="pcre2" negate="yes">(?i)(C:\\\\Program Files|\\\\wmiprvse\.exe)</field>
    <description>Sysmon Native [T1003.001]: lsass.exe process accessed by $(win.eventdata.sourceImage) with read permissions - possible credential dump</description>
    <options>no_full_log</options>
    <mitre><id>T1003.001</id></mitre>
  </rule>

  <!-- T1055 - Access to explorer.exe process (process injection) -->
  <rule id="92910" level="12">
    <if_sid>92899</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\\\explorer\.exe</field>
    <description>Sysmon Native [T1055]: explorer.exe process accessed by $(win.eventdata.sourceImage) - possible process injection</description>
    <options>no_full_log</options>
    <mitre><id>T1055</id></mitre>
  </rule>

  <!-- T1055 - Access to mstsc.exe process (RDP credential theft) -->
  <rule id="92920" level="14">
    <if_sid>92899</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\\\mstsc\.exe</field>
    <description>Sysmon Native [T1055]: Windows Remote Desktop utility mstsc.exe accessed by $(win.eventdata.sourceImage) - possible process injection or credential theft</description>
    <options>no_full_log</options>
    <mitre><id>T1055</id></mitre>
  </rule>

</group>
