  Rewrite by m0us3r - https://github.com/mym0us3r/Unified-Sysmon-Configs
  Date: 03/27/2026 Friday :)

  Sysmon Event ID 8 rules: 92399 - 92450
  Rewritten for Sysmon Native (Windows 11 24H2+)
  Provider: Microsoft-Windows-Sysmon
  EID 8: CreateRemoteThread - Cross-process injection and lateral movement
  MITRE ATT&CK v15 aligned

  ESCAPING REFERENCE (critical):
    Wazuh decoder doubles backslashes in Windows paths.
    Stored internally: C:\\Windows\\System32\\cmd.exe (double backslash)
    PCRE2 to match \\: use \\\\
    Rule: path separators -> \\\\ | regex meta (\s \d \b \.) -> \\

  MIGRATION NOTES:
    Legacy anchor if_group>sysmon_event8 replaced by:
      if_sid>92399 (Native EID 8 anchor, this file)
    ANCHOR FIX: if_sid>60000 replaced by if_group>sysmon_event8
    Base anchor was: if_sid>60000 + providerName + eventID ^8$ (rule 92399)
    All child rules chain from if_sid>92399 or their logical parent.
    Full parity with Wazuh 4.14.4 server ruleset + complete MITRE coverage.
-->
<group name="sysmon,sysmon_eid8_detections,windows,">

  <!-- ================================================================
       BASE ANCHOR - EID 8 (CreateRemoteThread)
  ================================================================ -->
  <rule id="92399" level="0">
    <if_group>sysmon_event8</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <description>Sysmon Native [EID 8]: CreateRemoteThread by $(win.eventdata.sourceImage) on $(win.eventdata.targetImage)</description>
    <options>no_full_log</options>
  </rule>

  <!-- T1055 - Code injection into explorer.exe -->
  <rule id="92400" level="12">
    <if_sid>92399</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)[c-z]:\\\\Windows\\\\explorer\.exe</field>
    <description>Sysmon Native [T1055]: Possible code injection on explorer.exe by $(win.eventdata.sourceImage)</description>
    <options>no_full_log</options>
    <mitre><id>T1055</id></mitre>
  </rule>

  <!-- T1055 - Code injection into mstsc.exe (RDP client) -->
  <rule id="92401" level="12">
    <if_sid>92399</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\\\mstsc\.exe</field>
    <description>Sysmon Native [T1055]: Possible code injection on mstsc.exe (Windows RDP utility) by $(win.eventdata.sourceImage)</description>
    <options>no_full_log</options>
    <mitre><id>T1055</id></mitre>
  </rule>

  <!-- T1055.003 / T1055.012 - Code injection into synchost/svchost -->
  <rule id="92402" level="3">
    <if_sid>92399</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\\\(synchost|svchost)\.exe</field>
    <description>Sysmon Native [T1055.003][T1055.012]: Possible code injection by $(win.eventdata.sourceImage) on $(win.eventdata.targetImage)</description>
    <options>no_full_log</options>
    <mitre><id>T1055.003</id><id>T1055.012</id></mitre>
  </rule>

  <!-- T1055 - Code injection into lsass.exe (credential dumping) -->
  <rule id="92403" level="12">
    <if_sid>92399</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\\\lsass\.exe</field>
    <description>Sysmon Native [T1055]: LSASS process accessed by $(win.eventdata.sourceImage) via CreateRemoteThread - possible code injection for credential dumping</description>
    <options>no_full_log</options>
    <mitre><id>T1055</id></mitre>
  </rule>

</group>
