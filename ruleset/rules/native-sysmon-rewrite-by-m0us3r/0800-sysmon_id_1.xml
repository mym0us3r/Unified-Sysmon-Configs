<!--
  Reference: Copyright (C) 2015, Wazuh Inc.
  Rewrite by m0us3r - https://github.com/mym0us3r/Unified-Sysmon-Configs
  Date: 03/27/2026 Friday :)

  Sysmon Event ID 1 rules: 92000 - 92100
  Rewritten for Sysmon Native (Windows 11 24H2+)
  Provider: Microsoft-Windows-Sysmon
  EID 1: Process Creation - Native anchor + full behavioral detection chain
  MITRE ATT&CK v15 aligned

  ESCAPING REFERENCE (critical):
    Wazuh decoder doubles backslashes in Windows paths.
    Stored internally: C:\\Windows\\System32\\cmd.exe (double backslash)
    PCRE2 to match \\: use \\\\
    Rule: path separators → \\\\ | regex meta (\s \d \b \.) → \\

  MIGRATION NOTES:
    ANCHOR FIX: if_sid>60000 replaced by if_group>sysmon_event1.
    Reason: if_group references a runtime group tag assigned by rule 61603
    (in 0595-win-sysmon_rules.xml) during event processing. The Wazuh rule
    engine walks depth-first from 60000 to 61603 and stops there. Rule 92000
    using if_sid>60000 was a sibling branch never reached at runtime.
    if_group>sysmon_event1 makes 92000 a child of any rule in that group,
    which is exactly what 61603 assigns on EID 1 events.
    providerName field check retained to enforce Native Sysmon only.
    eventID field removed (redundant - already implied by sysmon_event1 group).
    All child rules chain from if_sid>92000 or their logical parent.
    Duplicate rules removed: original 92022 == 92030 (kept as 92022).
    92077 and 92078: migrated to Native anchor.
    Full parity with Wazuh 4.14.4 server ruleset + complete MITRE coverage.
-->
<group name="sysmon,sysmon_eid1,windows,">

  <!-- ══════════════════════════════════════════════════════════════
       BASE ANCHOR — EID 1 (Process Creation)
       Replaces legacy if_group>sysmon_event1 across all child rules.
  ══════════════════════════════════════════════════════════════ -->
  <rule id="92000" level="3">
    <if_group>sysmon_event1</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <description>Sysmon Nativo [EID 1]: Processo criado - $(win.eventdata.image)</description>
    <options>no_full_log</options>
  </rule>

  <!-- ══════════════════════════════════════════════════════════════
       T1059.005 — Scripting Interpreter spawning processes
  ══════════════════════════════════════════════════════════════ -->
  <rule id="92001" level="4">
    <if_sid>92000</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\\\(c|w)script\.exe</field>
    <description>Sysmon Nativo [T1059.005]: Interpretador de script criou novo processo</description>
    <options>no_full_log</options>
    <mitre><id>T1059.005</id></mitre>
  </rule>

  <rule id="92002" level="6">
    <if_sid>92001</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\\\\(c|w)script\.exe.+\.(bat|cmd|lnk|pif|vbs|vbe|js|wsh|ps1)</field>
    <description>Sysmon Nativo [T1059]: Interpretador de script criou outro interpretador de script</description>
    <options>no_full_log</options>
    <mitre><id>T1059</id></mitre>
  </rule>

  <rule id="92003" level="6">
    <if_sid>92001</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">\\\\cmd\.exe</field>
    <description>Sysmon Nativo [T1059.003]: Interpretador de script criou instância do cmd.exe</description>
    <options>no_full_log</options>
    <mitre><id>T1059.003</id></mitre>
  </rule>

  <rule id="92004" level="6">
    <if_sid>92001</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)[c-z]:(\\\\Users\\\\Public\\\\|\\\\Users\\\\.+\\\\AppData\\\\local\\\\temp)</field>
    <description>Sysmon Nativo [T1059]: Interpretador de script criou processo em caminho suspeito</description>
    <options>no_full_log</options>
    <mitre><id>T1059</id></mitre>
  </rule>

  <!-- T1059.003 — PowerShell spawning cmd.exe -->
  <rule id="92005" level="4">
    <if_sid>92000</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">\\\\cmd\.exe</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\\\powershell\.exe</field>
    <description>Sysmon Nativo [T1059.003]: PowerShell criou instância do cmd.exe</description>
    <options>no_full_log</options>
    <mitre><id>T1059.003</id></mitre>
  </rule>

  <!-- T1059 — cmd /c|k iniciando script em localização suspeita -->
  <rule id="92082" level="8">
    <if_sid>92000</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\\\\(c|w)script\.exe.+[c-z]:\\\\(Windows\\\\Temp|Users)\\\\.+\.(bat|cmd|lnk|pif|vbs|vbe|js|wsh|ps1)</field>
    <field name="win.eventdata.parentCommandLine" type="pcre2">(?i)cmd\.exe.+/(c|k)</field>
    <description>Sysmon Nativo [T1059]: cmd.exe iniciou script com /c ou /k em localização suspeita</description>
    <options>no_full_log</options>
    <mitre><id>T1059</id></mitre>
  </rule>

  <!-- T1027.004 — PowerShell compilando código via csc.exe -->
  <rule id="92006" level="6">
    <if_sid>92000</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\csc\.exe</field>
    <field name="win.eventdata.parentCommandLine" type="pcre2">(?i)powershell.+ExecutionPolicy\s+bypass</field>
    <description>Sysmon Nativo [T1027.004]: Script PowerShell compilando código via CSC.exe (possível dropper)</description>
    <options>no_full_log</options>
    <mitre><id>T1027.004</id></mitre>
  </rule>

