  Date: 03/27/2026 Friday :)

  Sysmon Event ID 11 rules: 92199 - 92299
  Rewritten for Sysmon Native (Windows 11 24H2+)
  Provider: Microsoft-Windows-Sysmon
  EID 11: File Create - Suspicious file creation in high-risk paths
  MITRE ATT&CK v15 aligned

  ESCAPING REFERENCE (critical):
    Wazuh decoder doubles backslashes in Windows paths.
    Stored internally: C:\\Windows\\System32\\cmd.exe (double backslash)
    PCRE2 to match \\: use \\\\
    Rule: path separators -> \\\\ | regex meta (\s \d \b \.) -> \\

  MIGRATION NOTES:
    Legacy anchor if_group>sysmon_event_11 replaced by:
      if_sid>92199 (Native EID 11 anchor, this file)
    ANCHOR FIX: if_sid>60000 replaced by if_group>sysmon_event_11
    Base anchor was: if_sid>60000 + providerName + eventID ^11$ (rule 92199)
    All child rules chain from if_sid>92199 or their logical parent.
    Full parity with Wazuh 4.14.4 server ruleset + complete MITRE coverage.
-->
<group name="sysmon,sysmon_eid11_detections,windows,">

  <!-- ================================================================
       BASE ANCHOR - EID 11 (File Create)
  ================================================================ -->
  <rule id="92199" level="0">
    <if_group>sysmon_event_11</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <description>Sysmon Native [EID 11]: File created by $(win.eventdata.image)</description>
    <options>no_full_log</options>
  </rule>

  <!-- T1059 / T1105 - Script file created in Temp or User folder -->
  <rule id="92200" level="6">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)[c-z]:\\\\(Windows\\\\Temp|Users).+\.(bat|cmd|lnk|pif|vbs|vbe|js|wsh|ps1)</field>
    <description>Sysmon Native [T1059][T1105]: Scripting file created under Windows Temp or User folder</description>
    <options>no_full_log</options>
    <mitre><id>T1059</id><id>T1105</id></mitre>
  </rule>

  <rule id="92201" level="9">
    <if_sid>92200</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\((c|w)script|powershell)\.exe</field>
    <description>Sysmon Native [T1105][T1059]: $(win.eventdata.image) created a new scripting file under Windows Temp or User data folder</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id><id>T1059</id></mitre>
  </rule>

  <!-- T1570 - PAExec dropping executable in Windows root folder -->
  <rule id="92202" level="6">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)PAExec\.</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)[c-z]:\\\\Windows\\\\.+\.(exe|com|dll|vbs|js|bat|cmd|pif|wsh|ps1|lnk|msi|vbe)$</field>
    <description>Sysmon Native [T1570]: Executable dropped in Windows root folder by $(win.eventdata.image) - possible abuse of Windows admin shares</description>
    <options>no_full_log</options>
    <mitre><id>T1570</id></mitre>
  </rule>

  <!-- T1105 - PowerShell creating executable file -->
  <rule id="92203" level="6">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\powershell\.exe</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\.(exe|com|dll|vbs|js|bat|cmd|pif|wsh|ps1|lnk|msi|vbe)</field>
    <description>Sysmon Native [T1105]: Executable file created by PowerShell: $(win.eventdata.targetFilename)</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id></mitre>
  </rule>

  <rule id="92204" level="9">
    <if_sid>92203</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)AppData\\\\(Roaming|local)</field>
    <description>Sysmon Native [T1105]: PowerShell created executable file in AppData folder</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id></mitre>
  </rule>

  <rule id="92205" level="9">
    <if_sid>92203</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)Windows\\\\(system|syswow64|temp)</field>
    <description>Sysmon Native [T1105]: PowerShell created executable file in Windows root folder</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id></mitre>
  </rule>

  <!-- T1574.010 - PrintNightmare: DLL created by spooler service -->
  <rule id="92206" level="12">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\spoolsv\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)[c-z]:\\\\Windows\\\\System32\\\\spool\\\\drivers.+\.dll</field>
    <description>Sysmon Native [T1574.010]: DLL file created by printer spooler service - possible malware binary drop from PrintNightmare exploit</description>
    <options>no_full_log</options>
    <mitre><id>T1574.010</id></mitre>
  </rule>

  <!-- T1105 - Executable dropped in Users\Public folder -->
  <rule id="92207" level="12">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)[c-z]:\\\\Users\\\\Public\\\\.*\.(exe|com|dll|vbs|js|bat|cmd|pif|wsh|ps1|lnk|msi|vbe)</field>
    <description>Sysmon Native [T1105]: Executable file dropped in Users\Public folder</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id></mitre>
  </rule>

  <rule id="92208" level="15">
    <if_sid>92207</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\(scp|pscp|FZSFTP|sftp)\.exe</field>
    <description>Sysmon Native [T1105]: Executable file dropped in Users\Public folder by SSH-enabled copy software</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id></mitre>
  </rule>

  <!-- T1105 - .reg file created in Users\Public -->
  <rule id="92209" level="6">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)[c-z]:\\\\Users\\\\Public\\\\.*\.reg</field>
    <description>Sysmon Native [T1105]: Suspicious registry modification file (.reg) created in Users\Public folder</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id></mitre>
  </rule>

  <!-- T1105 - Compressed archive created in Users\Public -->
  <rule id="92210" level="6">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)[c-z]:\\\\Users\\\\Public\\\\.*\.(7z|zip|rar)</field>
    <description>Sysmon Native [T1105]: Suspicious file compression activity detected in Users\Public folder</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id></mitre>
  </rule>

  <!-- T1105 - rundll32 creating executable -->
  <rule id="92211" level="14">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\rundll32\.exe</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\.(exe|com|dll|vbs|js|bat|cmd|pif|wsh|ps1|lnk|msi|vbe)</field>
    <description>Sysmon Native [T1105]: Suspicious executable file creation by rundll32: $(win.eventdata.targetFilename)</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id></mitre>
  </rule>

  <!-- T1105 - PowerShell creating compressed archive -->
  <rule id="92212" level="14">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\powershell\.exe</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\.(7z|zip|rar)</field>
    <description>Sysmon Native [T1105]: Suspicious file compression activity by PowerShell: $(win.eventdata.targetFilename)</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id></mitre>
  </rule>

  <!-- T1105 - Executable dropped in AppData\Local\Temp -->
  <rule id="92213" level="15">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)[c-z]:\\\\Users\\\\.+\\\\AppData\\\\Local\\\\Temp\\\\.+\.(exe|com|dll|vbs|js|bat|cmd|pif|wsh|ps1|msi|vbe)</field>
    <description>Sysmon Native [T1105]: Executable file dropped in folder commonly used by malware (AppData\Local\Temp)</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id></mitre>
  </rule>

  <!-- T1027 - Office application creating .lnk file in AppData -->
  <rule id="92214" level="15">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\(winword|excel|powerpnt|outlook)\.exe</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)appdata\\\\.+\.lnk</field>
    <description>Sysmon Native [T1027]: Suspicious file created by Microsoft Office process: $(win.eventdata.image) created $(win.eventdata.targetFilename)</description>
    <options>no_full_log</options>
    <mitre><id>T1027</id></mitre>
  </rule>

  <!-- T1105 - mshta creating executable -->
  <rule id="92215" level="12">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\mshta\.exe</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\.(exe|com|dll|vbs|js|bat|cmd|pif|wsh|ps1|lnk|msi|vbe)</field>
    <description>Sysmon Native [T1105]: Executable file created by mshta: $(win.eventdata.targetFilename)</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id></mitre>
  </rule>

  <!-- T1105 / T1059.001 - PowerShell creating .tmp file in Temp (silent anchor) -->
  <rule id="92216" level="0">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)[c-z]:\\\\(Windows\\\\Temp|Users).+\.tmp</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\powershell\.exe</field>
    <description>Sysmon Native [T1105][T1059.001]: PowerShell created temporary file $(win.eventdata.targetFilename) in Windows Temp or User folder</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id><id>T1059.001</id></mitre>
  </rule>

  <!-- T1570 - Executable dropped in Windows root folder -->
  <rule id="92217" level="6">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)[c-z]:\\\\Windows\\\\.+\.(exe|com|dll|vbs|js|bat|cmd|pif|wsh|ps1|lnk|msi|vbe)$</field>
    <description>Sysmon Native [T1570]: Executable dropped in Windows root folder</description>
    <options>no_full_log</options>
    <mitre><id>T1570</id></mitre>
  </rule>

  <rule id="92218" level="6">
    <if_sid>92217</if_sid>
    <field name="win.eventdata.image" type="pcre2">^System$</field>
    <description>Sysmon Native [T1570]: Possible abuse of Windows admin shares - executable dropped in Windows root folder by System process</description>
    <options>no_full_log</options>
    <mitre><id>T1570</id></mitre>
  </rule>

  <rule id="92219" level="6">
    <if_sid>92217</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\svchost\.exe</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)[c-z]:\\\\Windows\\\\.+\.dll$</field>
    <description>Sysmon Native [T1574.001][T1574.002]: Possible DLL search order hijack - DLL created in Windows root folder by svchost: $(win.eventdata.targetFilename)</description>
    <options>no_full_log</options>
    <mitre><id>T1574.001</id><id>T1574.002</id></mitre>
  </rule>

  <rule id="92220" level="6">
    <if_sid>92217</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\wsmprovhost\.exe</field>
    <description>Sysmon Native [T1574][T1570]: Binary $(win.eventdata.targetFilename) created in Windows root folder by WinRM process $(win.eventdata.image)</description>
    <options>no_full_log</options>
    <mitre><id>T1574</id><id>T1570</id></mitre>
  </rule>

  <!-- T1105 - Screensaver executable creating file -->
  <rule id="92221" level="3">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\.*\.scr$</field>
    <description>Sysmon Native [T1105]: Screensaver executable $(win.eventdata.image) created $(win.eventdata.targetFilename)</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id></mitre>
  </rule>

  <!-- T1036 - LOLBAS binaries creating files in Windows folders -->
  <rule id="92222" level="3">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\(accesschk|calc|hex2dec)\.exe</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)Windows\\\\(SysWOW64|Temp|System32|System)</field>
    <description>Sysmon Native [T1036]: Suspicious executable $(win.eventdata.image) created a file in a Windows system folder</description>
    <options>no_full_log</options>
    <mitre><id>T1036</id></mitre>
  </rule>

  <!-- T1552 - .pfx file created (possible certificate/private key export) -->
  <rule id="92223" level="3">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\.pfx</field>
    <description>Sysmon Native [T1552]: PFX file $(win.eventdata.targetFilename) was created</description>
    <options>no_full_log</options>
    <mitre><id>T1552</id></mitre>
  </rule>

  <rule id="92224" level="6">
    <if_sid>92223</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\powershell\.exe</field>
    <description>Sysmon Native [T1552.004]: PowerShell created PFX file $(win.eventdata.targetFilename) - possible private key or certificate exportation</description>
    <options>no_full_log</options>
    <mitre><id>T1552.004</id></mitre>
  </rule>

  <!-- T1547.001 - Executable copied to Windows Startup folder -->
  <rule id="92225" level="6">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\\\ProgramData\\\\Microsoft\\\\Windows\\\\Start Menu\\\\Programs\\\\StartUp.+\.(exe|com|dll|vbs|js|bat|cmd|pif|wsh|ps1|lnk|msi|vbe)</field>
    <description>Sysmon Native [T1547.001]: Executable file has been copied to Windows Startup folder (persistence)</description>
    <options>no_full_log</options>
    <mitre><id>T1547.001</id></mitre>
  </rule>

  <rule id="92226" level="14">
    <if_sid>92203,92225</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\powershell\.exe</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\\\ProgramData\\\\Microsoft\\\\Windows\\\\Start Menu\\\\Programs\\\\StartUp</field>
    <description>Sysmon Native [T1547.001]: PowerShell copied executable to Windows Startup folder - confirmed persistence mechanism</description>
    <options>no_full_log</options>
    <mitre><id>T1547.001</id></mitre>
  </rule>

  <!-- T1105 - curl/wget/certutil creating DLL -->
  <rule id="92227" level="6">
    <if_sid>92199</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\(curl|wget|certutil)\.exe</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\.dll</field>
    <description>Sysmon Native [T1105]: Process $(win.eventdata.image) created a DLL binary: $(win.eventdata.targetFilename)</description>
    <options>no_full_log</options>
    <mitre><id>T1105</id></mitre>
  </rule>

</group>
