  Reference: Copyright (C) 2015, Wazuh Inc.
  Rewrite by m0us3r - https://github.com/mym0us3r/Unified-Sysmon-Configs
  03/27/2026 Friday :)

  Sysmon Process Anomaly rules: 184666 - 184777
  Rewritten for Sysmon Native (Windows 11 24H2+)
  Provider: Microsoft-Windows-Sysmon
  EID 1: Process Creation - Parent/Image anomaly detection chain
  MITRE ATT&CK v15 aligned

  ESCAPING REFERENCE (critical):
    Wazuh decoder doubles backslashes in Windows paths.
    Stored internally: C:\\Windows\\System32\\cmd.exe (double backslash)
    PCRE2 to match \\: use \\\\
    Rule: path separators -> \\\\ | regex meta (\s \d \b \.) -> \\

  MIGRATION NOTES:
    Legacy dispatcher rules (18100-based match + sysmon.* fields) removed.
    They are obsolete for Sysmon Native / eventchannel pipeline.
    ANCHOR FIX: if_sid>92000 replaced by if_group>sysmon_event1.
    Reason: if_group references a runtime group tag, not a compile-time rule ID.
    Group sysmon_event1 is assigned by rule 61603 (in 0595-win-sysmon_rules.xml)
    at event processing time. No load-order dependency issue.
    if_sid>92000 was failing silently because 92000 does not exist at load time
    (0330 loads before 0800 alphabetically).
    Field sysmon.image      -> win.eventdata.image
    Field sysmon.parentImage -> win.eventdata.parentImage
    Detection logic: suspicious process fires at level 12,
    legitimate parent image silences the alert at level 0.
    Path anchor added ($) to all image fields to prevent partial matches.
-->

<group name="sysmon,sysmon_process-anomalies,windows,">

  <!-- ================================================================
       T1055 - svchost.exe spawned by non-services.exe parent
  ================================================================ -->
  <rule id="184666" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\svchost\.exe$</field>
    <description>Sysmon Native [T1055]: Suspicious process - svchost.exe with non-standard parent image</description>
    <options>no_full_log</options>
    <mitre><id>T1055</id></mitre>
    <group>pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SI.4,tsc_CC7.2,tsc_CC7.3,tsc_CC6.1,tsc_CC6.8,</group>
  </rule>

  <rule id="184667" level="0">
    <if_sid>184666</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\\\services\.exe$</field>
    <description>Sysmon Native: Legitimate parent image - svchost.exe spawned by services.exe</description>
    <options>no_full_log</options>
  </rule>

